<?xml version="1.0"?>
<sdf version="1.9">
  <model name="aspirador">
    <pose>0 0 0 0 0 0</pose>
    <link name="base_link">
      <inertial><pose>0 0 0.065 0 0 0</pose><mass>3.2</mass>
        <inertia><ixx>0.030</ixx><iyy>0.040</iyy><izz>0.050</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="chassis_collision"><pose>0 0 0.067 0 0 0</pose><geometry><box><size>0.32 0.19 0.072</size></box></geometry></collision>
      <visual name="chassis"><pose>0 0 0.067 0 0 0</pose><geometry><box><size>0.32 0.19 0.072</size></box></geometry><material><ambient>0.18 0.22 0.24 1</ambient><diffuse>0.18 0.22 0.24 1</diffuse></material></visual>
      <!-- Nose wedge has a physical contact face; its tilt is a measured design parameter. -->
      <!-- Longer, low leading ramp reaches within 4 mm of the flat floor and
           overlaps the 12 mm threshold, allowing the treads to pull the nose up. -->
      <collision name="nose_ramp_collision"><pose>0.155 0 0.025 0 0.25 0</pose><geometry><box><size>0.14 0.18 0.020</size></box></geometry></collision>
      <visual name="nose_ramp"><pose>0.155 0 0.025 0 0.25 0</pose><geometry><box><size>0.14 0.18 0.020</size></box></geometry><material><ambient>0.35 0.40 0.42 1</ambient><diffuse>0.35 0.40 0.42 1</diffuse></material></visual>
    </link>
    <link name="left_track">
      <pose>0 0.145 0 0 0 0</pose><inertial><pose>0 0 0.045 0 0 0</pose><mass>0.40</mass><inertia><ixx>0.001</ixx><iyy>0.004</iyy><izz>0.004</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <!-- 5 mm contact overlap represents belt compliance and prevents a
           numerically exact tangent from losing all traction in the solver. -->
      <collision name="track_contact"><pose>0 0 0.038 0 0 0</pose><geometry><box><size>0.35 0.065 0.086</size></box></geometry><surface><friction><ode><mu>0.8</mu><mu2>1.2</mu2><fdir1>1 0 0</fdir1></ode></friction></surface></collision>
      <visual name="track_visual"><pose>0 0 0.043 0 0 0</pose><geometry><box><size>0.35 0.065 0.086</size></box></geometry><material><ambient>0.08 0.09 0.10 1</ambient><diffuse>0.08 0.09 0.10 1</diffuse></material></visual>
    </link>
    <joint name="left_track_mount" type="fixed"><parent>base_link</parent><child>left_track</child></joint>
    <link name="right_track">
      <pose>0 -0.145 0 0 0 0</pose><inertial><pose>0 0 0.045 0 0 0</pose><mass>0.40</mass><inertia><ixx>0.001</ixx><iyy>0.004</iyy><izz>0.004</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <!-- Same 5 mm compliant contact overlap as the other track. -->
      <collision name="track_contact"><pose>0 0 0.038 0 0 0</pose><geometry><box><size>0.35 0.065 0.086</size></box></geometry><surface><friction><ode><mu>0.8</mu><mu2>1.2</mu2><fdir1>1 0 0</fdir1></ode></friction></surface></collision>
      <visual name="track_visual"><pose>0 0 0.043 0 0 0</pose><geometry><box><size>0.35 0.065 0.086</size></box></geometry><material><ambient>0.08 0.09 0.10 1</ambient><diffuse>0.08 0.09 0.10 1</diffuse></material></visual>
    </link>
    <joint name="right_track_mount" type="fixed"><parent>base_link</parent><child>right_track</child></joint>
    <link name="lidar_link"><pose>0 0 0.133 0 0 0</pose><inertial><mass>0.02</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name="lidar" type="gpu_lidar"><topic>/scan</topic><gz_frame_id>lidar_link</gz_frame_id><update_rate>10</update_rate><pose>0 0 0 0 0 0</pose><visualize>true</visualize><ray><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.08</min><max>8.0</max><resolution>0.01</resolution></range></ray><always_on>true</always_on>
      </sensor>
    </link>
    <joint name="lidar_mount" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>
    <link name="imu_link"><pose>0 0 0.09 0 0 0</pose><inertial><mass>0.01</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name="imu" type="imu"><topic>/imu/data</topic><gz_frame_id>imu_link</gz_frame_id><update_rate>50</update_rate><always_on>true</always_on><imu><angular_velocity><x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x><y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y><z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z></angular_velocity><linear_acceleration><x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x><y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y><z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z></linear_acceleration></imu></sensor>
    </link>
    <joint name="imu_mount" type="fixed"><parent>base_link</parent><child>imu_link</child></joint>
    <plugin name="gz::sim::systems::TrackedVehicle" filename="gz-sim-tracked-vehicle-system">
      <left_track><link>left_track</link></left_track><right_track><link>right_track</link></right_track>
      <tracks_separation>0.29</tracks_separation><tracks_height>0.086</tracks_height><steering_efficiency>0.5</steering_efficiency>
      <topic>/cmd_vel</topic><odom_topic>/wheel/odometry</odom_topic><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id><odom_publish_frequency>50</odom_publish_frequency>
      <linear_velocity><min_velocity>-0.20</min_velocity><max_velocity>0.20</max_velocity><max_acceleration>0.25</max_acceleration></linear_velocity>
      <angular_velocity><min_velocity>-1.2</min_velocity><max_velocity>1.2</max_velocity><max_acceleration>1.5</max_acceleration></angular_velocity>
    </plugin>
    <plugin name="gz::sim::systems::TrackController" filename="gz-sim-track-controller-system"><link>left_track</link><min_velocity>-0.35</min_velocity><max_velocity>0.35</max_velocity><max_acceleration>0.4</max_acceleration></plugin>
    <plugin name="gz::sim::systems::TrackController" filename="gz-sim-track-controller-system"><link>right_track</link><min_velocity>-0.35</min_velocity><max_velocity>0.35</max_velocity><max_acceleration>0.4</max_acceleration></plugin>
  </model>
</sdf>
