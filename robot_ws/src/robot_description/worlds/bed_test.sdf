<?xml version="1.0"?>
<sdf version="1.9">
  <world name="casa">
    <physics name="bed_physics" type="ignored"><max_step_size>0.002</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <scene><ambient>0.65 0.65 0.65 1</ambient><background>0.86 0.88 0.90 1</background></scene>
    <light name="sun" type="directional"><pose>0 0 8 0 0 0</pose><direction>-0.4 0.2 -1</direction><diffuse>0.8 0.8 0.8 1</diffuse></light>
    <model name="floor"><static>true</static><link name="floor_link">
      <collision name="floor_collision"><pose>2.6 1.75 -0.04 0 0 0</pose><geometry><box><size>6.0 4.0 0.08</size></box></geometry></collision>
      <visual name="floor_visual"><pose>2.6 1.75 -0.04 0 0 0</pose><geometry><box><size>6.0 4.0 0.08</size></box></geometry></visual>
    </link></model>
    <model name="room_walls"><static>true</static><link name="walls">
      <collision name="west"><pose>-0.37 1.75 0.5 0 0 0</pose><geometry><box><size>0.06 4.0 1.0</size></box></geometry></collision>
      <collision name="east"><pose>5.57 1.75 0.5 0 0 0</pose><geometry><box><size>0.06 4.0 1.0</size></box></geometry></collision>
      <collision name="south"><pose>2.6 -0.22 0.5 0 0 0</pose><geometry><box><size>6.0 0.06 1.0</size></box></geometry></collision>
      <collision name="north"><pose>2.6 3.72 0.5 0 0 0</pose><geometry><box><size>6.0 0.06 1.0</size></box></geometry></collision>
    </link></model>
    <!-- Exact bed collision geometry copied from casa.sdf. Its mattress underside
         is 0.34 - 0.22 / 2 = 0.23 m above the floor. -->
    <model name="bed"><static>true</static><pose>2.65 1.75 0 0 0 0</pose><link name="bed_frame">
      <collision name="mattress"><pose>0 0 0.34 0 0 0</pose><geometry><box><size>1.65 1.25 0.22</size></box></geometry></collision>
      <visual name="mattress_v"><pose>0 0 0.34 0 0 0</pose><geometry><box><size>1.65 1.25 0.22</size></box></geometry></visual>
      <collision name="leg1"><pose>-0.72 -0.52 0.10 0 0 0</pose><geometry><box><size>0.06 0.06 0.20</size></box></geometry></collision>
      <collision name="leg2"><pose>0.72 -0.52 0.10 0 0 0</pose><geometry><box><size>0.06 0.06 0.20</size></box></geometry></collision>
      <collision name="leg3"><pose>-0.72 0.52 0.10 0 0 0</pose><geometry><box><size>0.06 0.06 0.20</size></box></geometry></collision>
      <collision name="leg4"><pose>0.72 0.52 0.10 0 0 0</pose><geometry><box><size>0.06 0.06 0.20</size></box></geometry></collision>
    </link></model>
    <include><uri>model://vacuum</uri><name>aspirador</name><pose>1.35 1.75 0 0 0 0</pose></include>
  </world>
</sdf>
